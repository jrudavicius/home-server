# For manual deployment, copy to .env and fill credentials only in that copy.
# Komodo deployments use the Pi's bootstrap.env; see README.md: Credential setup.

# Image versions and digests are pinned in docker-compose.yml.

GRAFANA_PORT=3000
GRAFANA_TRAEFIK_HOST=grafana.home.arpa
GRAFANA_ROOT_URL=http://grafana.home.arpa/
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Only used with docker-compose.discord.yml; keep the real URL private.
GRAFANA_DISCORD_WEBHOOK_URL=
GRAFANA_PLUGINS_PREINSTALL_DISABLED=true
GRAFANA_PLUGINS_PREINSTALL_AUTO_UPDATE=false

LOKI_RETENTION_PERIOD=168h
LOKI_MAX_QUERY_LOOKBACK=168h

DOCKER_SOCKET_PATH=/var/run/docker.sock
