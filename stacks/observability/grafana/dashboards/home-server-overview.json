        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count(sum by (container) (count_over_time({job=\"docker\", compose_project=~`${compose_project:regex}`, service=~`${service:regex}`, container=~`${container:regex}`}[5m]))) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
