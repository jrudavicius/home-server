# Runtime environment files; only empty credential templates belong in Git.
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Local secret directories and the default Transmission password file.
secrets/
.secrets/
transmission_user_password.txt
core.config.json

# Python validation and test bytecode.
__pycache__/

# WireGuard client configs contain private keys.
wg0.conf
home-server-*.conf

# Keep filled-in router scripts, exports and provider keys local.
router/*.rsc
router/*.backup
router/*.conf
router/*.key
