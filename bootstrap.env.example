# Copy to /srv/komodo/bootstrap.env on the Pi and fill credentials there.
# See README.md: Credential setup. Never put real credentials in this example.

# Network
HOST_BIND_ADDRESS=0.0.0.0

# Komodo
# Existing Docker volume prefix, independent of the management stack name.
MANAGEMENT_VOLUME_PREFIX=server
DOCKER_SOCKET_PATH=/var/run/docker.sock
KOMODO_IMAGE_TAG=2
KOMODO_PORT=9120
KOMODO_BACKUPS_PATH=/srv/komodo/backups
KOMODO_DATABASE_USERNAME=
KOMODO_DATABASE_PASSWORD=
KOMODO_HOST=http://komodo.home.arpa
KOMODO_WEBHOOK_BASE_URL=
KOMODO_TRAEFIK_HOST=komodo.home.arpa
KOMODO_INIT_ADMIN_USERNAME=
KOMODO_INIT_ADMIN_PASSWORD=
KOMODO_FIRST_SERVER_NAME=home-server
KOMODO_WEBHOOK_SECRET=
KOMODO_JWT_SECRET=
PERIPHERY_ROOT_DIRECTORY=/srv/komodo/periphery

# Application secrets loaded into Komodo automatically by secret-bootstrap.
# Required, single-line values. Follow Compose .env quoting rules for symbols.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
TRANSMISSION_USERNAME=
NGROK_AUTHTOKEN=

# Optional, only for initial Plex claiming. Clear after Plex is claimed.
PLEX_CLAIM=
